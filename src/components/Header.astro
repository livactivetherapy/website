---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localizedPath, type Lang, languages } from '../i18n/ui';
import { site } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);

const services = (await getCollection('services', ({ data }) => data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order);

type NavItem = {
  href?: string;
  label: string;
  dropdown?: Array<{ href: string; label: string; icon: string; external?: boolean; download?: boolean }>;
};

const nav: NavItem[] = [
  { href: L('/'), label: t('nav.home') },
  {
    href: L('/services'),
    label: t('nav.services'),
    dropdown: [
      ...services.map((s) => ({ href: L(`/services/${s.data.slug}`), label: s.data.title, icon: s.data.icon })),
      { href: L('/accident-injury'), label: t('nav.injury'), icon: 'pulse' },
    ],
  },
  { href: L('/about'), label: t('nav.about') },
  { href: L('/team'), label: t('nav.team') },
  { href: L('/locations'), label: t('nav.locations') },
  {
    label: t('nav.forms'),
    dropdown: [
      { href: L('/forms/english'), label: t('footer.formsEn'), icon: 'arrow' },
      { href: L('/forms/spanish'), label: t('footer.formsEs'), icon: 'arrow' },
    ],
  },
  { href: L('/contact'), label: t('nav.contact') },
];

// Build alternate-language path for current page
const currentPath = Astro.url.pathname;
const altLang: Lang = lang === 'en' ? 'es' : 'en';
const stripped = lang === 'en' ? currentPath : currentPath.replace(/^\/es/, '') || '/';
const altPath = altLang === 'en' ? stripped : `/es${stripped === '/' ? '' : stripped}`;

const primaryPhone = site.locations[0].phoneHref;
---
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur">
  <div class="container-x flex h-20 items-center justify-between gap-4">
    <a href={L('/')} class="flex items-center shrink-0 self-center">
      <Logo class="h-10 md:h-12 w-auto block" />
    </a>

    <nav class="hidden lg:flex items-center gap-1 self-center" aria-label="Primary">
      {nav.map((item) =>
        item.dropdown ? (
          <div class="relative group">
            {item.href ? (
              <a
                href={item.href}
                class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-ink-700 hover:text-brand-700 transition-colors"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </a>
            ) : (
              <button
                type="button"
                class="inline-flex items-center gap-1 px-3 py-2 text-sm font-medium text-ink-700 hover:text-brand-700 transition-colors"
                aria-haspopup="true"
              >
                {item.label}
                <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </button>
            )}
            <!-- Dropdown panel -->
            <div class="absolute left-0 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible focus-within:opacity-100 focus-within:visible transition-all duration-150 z-50">
              <div class="rounded-2xl bg-white shadow-xl ring-1 ring-ink-100 p-2 min-w-[300px]">
                {item.dropdown.map((d) => (
                  <a
                    href={d.href}
                    target={d.external ? '_blank' : undefined}
                    rel={d.external ? 'noopener' : undefined}
                    download={d.download ? '' : undefined}
                    class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-brand-50 transition-colors group/item"
                  >
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 group-hover/item:bg-brand-600 group-hover/item:text-white transition-colors">
                      <Icon name={d.icon} class="h-4 w-4" />
                    </span>
                    <span class="text-sm font-semibold text-ink-800 group-hover/item:text-brand-800">
                      {d.label}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class="px-3 py-2 text-sm font-medium text-ink-700 hover:text-brand-700 transition-colors"
          >
            {item.label}
          </a>
        )
      )}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={altPath}
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-ink-700 hover:bg-ink-50 transition"
        aria-label={`Switch to ${languages[altLang]}`}
      >
        <Icon name="globe" class="h-4 w-4" />
        {altLang.toUpperCase()}
      </a>
      <a
        href={primaryPhone}
        class="hidden md:inline-flex items-center gap-2 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition shadow-sm shadow-brand-900/10"
      >
        <Icon name="phone" class="h-4 w-4" />
        {t('cta.call')}
      </a>
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-ink-700 hover:bg-ink-50"
        data-mobile-toggle
        aria-label="Open menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    data-mobile-panel
    class="lg:hidden hidden border-t border-ink-100 bg-white"
  >
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobile">
      {nav.map((item) =>
        item.dropdown ? (
          <details class="group border-b border-ink-100/60 last:border-b-0">
            <summary class="list-none cursor-pointer py-3 flex items-center justify-between text-base font-medium text-ink-800 hover:text-brand-700">
              <span>{item.label}</span>
              <svg class="h-4 w-4 text-ink-500 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="pl-4 border-l-2 border-brand-100 ml-1 mb-2 flex flex-col gap-1">
              {item.href && (
                <a
                  href={item.href}
                  class="flex items-center gap-2.5 py-2 text-sm font-semibold text-brand-700 hover:text-brand-800"
                >
                  <Icon name="arrow" class="h-4 w-4" />
                  {lang === 'es' ? 'Ver todo' : 'View all'}
                </a>
              )}
              {item.dropdown.map((d) => (
                <a
                  href={d.href}
                  target={d.external ? '_blank' : undefined}
                  rel={d.external ? 'noopener' : undefined}
                  download={d.download ? '' : undefined}
                  class="flex items-center gap-2.5 py-2 text-sm font-medium text-ink-700 hover:text-brand-700"
                >
                  <Icon name={d.icon} class="h-4 w-4 text-brand-600" />
                  {d.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class="py-3 text-base font-medium text-ink-800 hover:text-brand-700 border-b border-ink-100/60 last:border-b-0"
          >
            {item.label}
          </a>
        )
      )}
      <a
        href={altPath}
        class="py-3 text-base font-medium text-ink-600"
      >
        {languages[altLang]}
      </a>
      <a
        href={primaryPhone}
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-4 py-3 text-base font-semibold text-white"
      >
        <Icon name="phone" class="h-5 w-5" />
        {t('cta.call')}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-panel]');

  const setOpen = (open: boolean) => {
    if (!btn || !panel) return;
    panel.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    // Lock body scroll while the menu is open
    document.body.style.overflow = open ? 'hidden' : '';
  };

  btn?.addEventListener('click', () => {
    const isCurrentlyClosed = panel?.classList.contains('hidden');
    setOpen(!!isCurrentlyClosed);
  });

  // If the viewport grows past mobile breakpoint (e.g. user rotates device or resizes),
  // close the menu and unlock scroll.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
