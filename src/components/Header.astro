---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { useTranslations, localizedPath, type Lang, languages } from '../i18n/ui';
import { site } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);

const nav = [
  { href: L('/'), label: t('nav.home') },
  { href: L('/services'), label: t('nav.services') },
  { href: L('/about'), label: t('nav.about') },
  { href: L('/team'), label: t('nav.team') },
  { href: L('/locations'), label: t('nav.locations') },
  { href: L('/contact'), label: t('nav.contact') },
];

// Build alternate-language path for current page
const currentPath = Astro.url.pathname;
const altLang: Lang = lang === 'en' ? 'es' : 'en';
const stripped = lang === 'en' ? currentPath : currentPath.replace(/^\/es/, '') || '/';
const altPath = altLang === 'en' ? stripped : `/es${stripped === '/' ? '' : stripped}`;

const primaryPhone = site.locations[0].phoneHref;
---
<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/85 backdrop-blur">
  <div class="container-x flex h-20 items-center justify-between gap-4">
    <a href={L('/')} class="flex items-center shrink-0 self-center">
      <Logo class="h-10 md:h-12 w-auto block" />
    </a>

    <nav class="hidden lg:flex items-center gap-1 self-center" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class="px-3 py-2 text-sm font-medium text-ink-700 hover:text-brand-700 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={altPath}
        class="hidden sm:inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-ink-700 hover:bg-ink-50 transition"
        aria-label={`Switch to ${languages[altLang]}`}
      >
        <Icon name="globe" class="h-4 w-4" />
        {altLang.toUpperCase()}
      </a>
      <a
        href={primaryPhone}
        class="hidden md:inline-flex items-center gap-2 rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700 transition shadow-sm shadow-brand-900/10"
      >
        <Icon name="phone" class="h-4 w-4" />
        {t('cta.call')}
      </a>
      <button
        type="button"
        class="lg:hidden inline-flex items-center justify-center rounded-md p-2 text-ink-700 hover:bg-ink-50"
        data-mobile-toggle
        aria-label="Open menu"
        aria-expanded="false"
      >
        <Icon name="menu" class="h-6 w-6" />
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div
    data-mobile-panel
    class="lg:hidden hidden border-t border-ink-100 bg-white"
  >
    <nav class="container-x py-4 flex flex-col gap-1" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="py-3 text-base font-medium text-ink-800 hover:text-brand-700"
        >
          {item.label}
        </a>
      ))}
      <a
        href={altPath}
        class="py-3 text-base font-medium text-ink-600"
      >
        {languages[altLang]}
      </a>
      <a
        href={primaryPhone}
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 px-4 py-3 text-base font-semibold text-white"
      >
        <Icon name="phone" class="h-5 w-5" />
        {t('cta.call')}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector('[data-mobile-toggle]');
  const panel = document.querySelector('[data-mobile-panel]');
  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', open ? 'false' : 'true');
  });
</script>
