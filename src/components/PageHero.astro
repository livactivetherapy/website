---
interface Props {
  eyebrow: string;
  subtitle?: string;
}
const { eyebrow, subtitle } = Astro.props;
---
<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/4 h-[28rem] w-[28rem] rounded-full bg-brand-200/30 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 right-1/4 h-96 w-96 rounded-full bg-accent-200/30 blur-3xl"></div>

  <div class="container-x relative pt-20 pb-20 md:pt-28 md:pb-28 text-center max-w-4xl mx-auto">
    <span class="inline-flex items-center gap-2 rounded-full bg-white ring-1 ring-brand-200 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.18em] text-brand-700">
      <span class="h-1.5 w-1.5 rounded-full bg-accent-500 animate-pulse"></span>
      {eyebrow}
    </span>
    <h1 class="mt-6 text-4xl md:text-6xl font-extrabold tracking-tight text-ink-900">
      <slot />
    </h1>
    {subtitle && (
      <p class="mt-6 text-lg md:text-xl text-ink-600 leading-relaxed max-w-2xl mx-auto">
        {subtitle}
      </p>
    )}
  </div>
</section>
