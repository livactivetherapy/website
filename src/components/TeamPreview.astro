---
import { getCollection } from 'astro:content';
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  compact?: boolean;
  noHeader?: boolean;
}
const { lang, compact = false, noHeader = false } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);

const allTeam = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
// regular therapists (always exclude founders from the main grid)
const team = allTeam.filter((m) => !m.data.founder);
// founders (only shown on the full /team page, in their own combined card)
const founders = compact ? [] : allTeam.filter((m) => m.data.founder);

const gridClass = compact
  ? 'grid gap-5 sm:grid-cols-2 lg:grid-cols-3'
  : 'grid gap-6 md:grid-cols-2';

const HeadingTag = compact ? 'h2' : 'h1';
---
<section class="bg-ink-50/60 py-20 md:py-28">
  <div class="container-x">
    {!noHeader && (
      <div class={compact ? 'max-w-2xl mx-auto text-center' : 'max-w-3xl mx-auto text-center'}>
        <HeadingTag class={compact ? 'text-3xl md:text-4xl font-bold text-ink-900' : 'text-4xl md:text-5xl font-bold text-ink-900'}>
          {t('team.title')}
        </HeadingTag>
        {!compact && (
          <p class="mt-4 text-lg text-ink-600">{t('team.subtitle')}</p>
        )}
      </div>
    )}

    <ul class={`${noHeader ? '' : 'mt-12'} ${gridClass}`}>
      {team.map((m) => {
        const hasPhoto = !!m.data.photo;
        return (
          <li class={`rounded-[var(--radius-card)] bg-white ring-1 ring-ink-100 ${compact ? 'p-5' : 'p-6 md:p-7'}`}>
            {compact ? (
              hasPhoto ? (
                <div class="flex items-center gap-4">
                  <img
                    src={m.data.photo}
                    alt={m.data.name}
                    width="128"
                    height="128"
                    loading="lazy"
                    decoding="async"
                    class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-brand-100"
                  />
                  <div class="min-w-0">
                    <h3 class="text-base font-semibold text-ink-900 truncate">{m.data.name}</h3>
                    <p class="text-xs text-brand-700 font-medium">{m.data.credentials}</p>
                    <p class="text-xs text-ink-600 mt-0.5">{m.data.role[lang]}</p>
                  </div>
                </div>
              ) : (
                <div class="flex h-full flex-col justify-center">
                  <h3 class="text-base font-semibold text-ink-900">{m.data.name}</h3>
                  <p class="text-xs text-brand-700 font-medium mt-1">{m.data.credentials}</p>
                  <p class="text-xs text-ink-600 mt-0.5">{m.data.role[lang]}</p>
                </div>
              )
            ) : (
              hasPhoto ? (
                <>
                  <div class="flex gap-5 items-start">
                    <img
                      src={m.data.photo}
                      alt={m.data.name}
                      width="224"
                      height="224"
                      loading="lazy"
                      decoding="async"
                      class="h-24 w-24 md:h-28 md:w-28 shrink-0 rounded-2xl object-cover ring-2 ring-brand-100"
                    />
                    <div class="min-w-0 flex-1">
                      <h3 class="text-xl font-semibold text-ink-900">{m.data.name}</h3>
                      <p class="mt-0.5 text-sm text-brand-700 font-medium">{m.data.credentials}</p>
                      <p class="mt-1 text-sm text-ink-600">{m.data.role[lang]}</p>
                    </div>
                  </div>
                  <p class="mt-5 text-sm text-ink-600 leading-relaxed">{m.data.bio[lang]}</p>
                </>
              ) : (
                <>
                  <div>
                    <h3 class="text-xl font-semibold text-ink-900">{m.data.name}</h3>
                    <p class="mt-0.5 text-sm text-brand-700 font-medium">{m.data.credentials}</p>
                    <p class="mt-1 text-sm text-ink-600">{m.data.role[lang]}</p>
                  </div>
                  <p class="mt-5 text-sm text-ink-600 leading-relaxed">{m.data.bio[lang]}</p>
                </>
              )
            )}
          </li>
        );
      })}

      {founders.length > 0 && (
        <li class="md:col-span-2 rounded-[var(--radius-card)] bg-gradient-to-br from-brand-50 via-white to-brand-50 ring-1 ring-brand-200 p-6 md:p-8 relative overflow-hidden">
          <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-brand-200/40 blur-3xl"></div>
          <div aria-hidden="true" class="pointer-events-none absolute -bottom-16 -left-16 h-48 w-48 rounded-full bg-accent-200/30 blur-3xl"></div>

          <div class="relative">
            <span class="inline-flex items-center gap-2 rounded-full bg-white ring-1 ring-brand-200 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-brand-700">
              {lang === 'es' ? 'Nuestros Fundadores' : 'Our Founders'}
            </span>

            <div class="mt-6 grid md:grid-cols-2 gap-6 md:gap-10 md:divide-x md:divide-brand-200/60">
              {founders.map((f, idx) => (
                <div class={idx === 1 ? 'md:pl-10' : ''}>
                  <h3 class="text-2xl font-bold text-ink-900">{f.data.name}</h3>
                  <p class="mt-1 text-sm text-brand-700 font-semibold">{f.data.credentials}</p>
                  <p class="mt-1 text-sm text-ink-600">{f.data.role[lang]}</p>
                  <p class="mt-4 text-sm text-ink-600 leading-relaxed">{f.data.bio[lang]}</p>
                </div>
              ))}
            </div>

            <div class="mt-8 pt-6 border-t border-brand-200/50">
              <p class="text-base md:text-lg text-ink-700 italic leading-relaxed">
                {lang === 'es'
                  ? 'Juntos abrieron Liv Active Therapy para brindar la más alta calidad de atención a todas las personas en un ambiente positivo y compasivo, con servicios proporcionados por terapeutas altamente calificados y con conocimiento.'
                  : 'Together they opened Liv Active Therapy to provide the highest quality of care to all people in a positive and compassionate environment, with services delivered by highly skilled and knowledgeable therapists.'}
              </p>
            </div>
          </div>
        </li>
      )}
    </ul>

    {compact && (
      <div class="mt-12 flex justify-center">
        <a
          href={L('/team')}
          class="inline-flex items-center gap-2 rounded-full bg-white ring-1 ring-brand-200 px-6 py-3 text-sm font-semibold text-brand-700 hover:bg-brand-50 hover:ring-brand-300 transition shadow-sm"
        >
          {lang === 'es' ? 'Sobre el equipo' : 'About the team'}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    )}
  </div>
</section>
