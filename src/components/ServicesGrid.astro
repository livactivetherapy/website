---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; noHeader?: boolean }
const { lang, noHeader = false } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);

const all = await getCollection('services', ({ data }) => data.lang === lang);
const services = all.sort((a, b) => a.data.order - b.data.order);
---
<section id="services" class="py-20 md:py-28">
  <div class="container-x">
    {!noHeader && (
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-bold text-ink-900">{t('services.title')}</h2>
        <p class="mt-4 text-lg text-ink-600">{t('services.subtitle')}</p>
      </div>
    )}

    <ul class={`${noHeader ? '' : 'mt-12'} grid gap-5 sm:grid-cols-2 lg:grid-cols-3`}>
      {services.map((s) => (
        <li>
          <a
            href={L(`/services/${s.data.slug}`)}
            class="group block h-full rounded-[var(--radius-card)] bg-white p-7 ring-1 ring-ink-100 hover:ring-brand-300 hover:shadow-xl hover:shadow-brand-900/5 transition-all"
          >
            <div class="flex items-start gap-4">
              <div class="h-12 w-12 shrink-0 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center group-hover:bg-brand-100 transition">
                <Icon name={s.data.icon} class="h-6 w-6" />
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-ink-900">{s.data.title}</h3>
                <p class="mt-2 text-sm text-ink-600 leading-relaxed">{s.data.summary}</p>
                <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700">
                  {t('cta.learn')}
                  <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
