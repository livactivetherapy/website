---
import Icon from './Icon.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);
---
<section class="relative overflow-hidden bg-gradient-to-br from-brand-800 via-brand-900 to-brand-950">
  <!-- subtle brand-blue glows -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-brand-600/30 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -right-32 -translate-y-1/2 h-[28rem] w-[28rem] rounded-full bg-brand-500/25 blur-3xl"></div>

  <div class="container-x relative py-16 md:py-20 grid lg:grid-cols-12 gap-10 items-center">
    <!-- Text content -->
    <div class="lg:col-span-6 relative">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-brand-200">
        <span class="h-px w-8 bg-brand-300"></span>
        {t('promise.eyebrow')}
      </span>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
        {t('promise.title')}
      </h2>
      <p class="mt-5 text-base text-brand-100/90 leading-relaxed max-w-xl">
        {t('promise.body')}
      </p>
      <div class="mt-7">
        <a
          href={L('/contact')}
          class="inline-flex items-center gap-2 rounded-full bg-white text-brand-900 px-6 py-3 text-sm font-semibold hover:bg-brand-50 transition shadow-md shadow-brand-950/30"
        >
          {t('promise.cta')}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Image placeholder -->
    <div class="lg:col-span-6">
      <div class="relative aspect-[4/3] rounded-2xl overflow-hidden ring-1 ring-white/10 bg-gradient-to-br from-brand-700/60 via-brand-900 to-brand-950">
        <!-- subtle brand glow accent -->
        <div aria-hidden="true" class="absolute right-1/3 top-1/2 -translate-y-1/2 h-64 w-64 rounded-full bg-brand-500/35 blur-3xl"></div>
        <div aria-hidden="true" class="absolute right-1/3 top-1/2 -translate-y-1/2 h-28 w-28 rounded-full bg-brand-400/40 blur-2xl"></div>

        <div class="absolute inset-0 flex flex-col items-center justify-center text-white/55 z-10">
          <svg class="h-14 w-14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" />
            <circle cx="12" cy="13" r="4" />
          </svg>
          <p class="mt-3 text-xs font-bold uppercase tracking-[0.22em]">Photo placeholder</p>
          <p class="mt-1 text-xs text-white/40">Patient / treatment shot</p>
        </div>
      </div>
    </div>
  </div>
</section>
