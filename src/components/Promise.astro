---
import Icon from './Icon.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizedPath(lang, p);
---
<section class="relative overflow-hidden bg-gradient-to-br from-brand-800 via-brand-900 to-brand-950">
  <!-- subtle brand-blue glows -->
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-[28rem] w-[28rem] rounded-full bg-brand-600/30 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -right-32 -translate-y-1/2 h-[28rem] w-[28rem] rounded-full bg-brand-500/25 blur-3xl"></div>

  <div class="container-x relative py-16 md:py-20 grid lg:grid-cols-12 gap-10 items-center">
    <!-- Text content -->
    <div class="lg:col-span-6 relative">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.22em] text-brand-200">
        <span class="h-px w-8 bg-brand-300"></span>
        {t('promise.eyebrow')}
      </span>
      <h2 class="mt-4 text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
        {t('promise.title')}
      </h2>
      <p class="mt-5 text-base text-brand-100/90 leading-relaxed max-w-xl">
        {t('promise.body')}
      </p>
      <div class="mt-7">
        <a
          href={L('/contact')}
          class="inline-flex items-center gap-2 rounded-full bg-white text-brand-900 px-6 py-3 text-sm font-semibold hover:bg-brand-50 transition shadow-md shadow-brand-950/30"
        >
          {t('promise.cta')}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="hidden lg:block lg:col-span-6">
      <img
        src="/home/main.jpg"
        alt="LIV Active Therapy"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] w-full object-cover rounded-2xl ring-1 ring-white/10 shadow-xl shadow-brand-950/30"
      />
    </div>
  </div>
</section>
