---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { site } from '../config/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="py-20">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[var(--radius-card)] bg-brand-700 px-8 py-14 md:px-16 md:py-20">
      <div aria-hidden="true" class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_20%,white,transparent_40%),radial-gradient(circle_at_80%_70%,var(--color-accent-400),transparent_40%)]"></div>
      <div class="relative max-w-3xl">
        <h2 class="text-3xl md:text-4xl font-bold text-white">
          {t('cta.banner.title')}
        </h2>
        <p class="mt-4 text-lg text-brand-100 leading-relaxed">
          {t('cta.banner.body')}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={site.locations[0].phoneHref}
            class="inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-base font-semibold text-brand-700 hover:bg-brand-50 transition"
          >
            <Icon name="phone" class="h-5 w-5" />
            {t('cta.call')}
          </a>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 rounded-full bg-accent-500 px-6 py-3 text-base font-semibold text-white hover:bg-accent-600 transition"
          >
            {lang === 'es' ? 'Escríbenos' : 'Send a message'}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
