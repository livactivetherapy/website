---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Icon from './Icon.astro';
import { type Lang } from '../i18n/ui';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  /** "card" = full card on contact page, "compact" = footer band */
  variant?: 'card' | 'compact';
}
const { lang, variant = 'card' } = Astro.props;

const enPath = site.forms.en;
const esPath = site.forms.es;
const hasEn = existsSync(join(process.cwd(), 'public', enPath));
const hasEs = existsSync(join(process.cwd(), 'public', esPath));

const copy = lang === 'es'
  ? {
      title: 'Formularios de registro',
      body: 'Ahorra tiempo en tu primera visita — descarga y completa los formularios antes de venir.',
      enLabel: 'En inglés',
      esLabel: 'En español',
      soon: 'Próximamente',
    }
  : {
      title: 'Registration forms',
      body: 'Save time on your first visit — download and fill out the forms before you come in.',
      enLabel: 'English form',
      esLabel: 'Spanish form',
      soon: 'Coming soon',
    };
---
{variant === 'card' ? (
  <div class="rounded-[var(--radius-card)] bg-white ring-1 ring-ink-100 p-6 md:p-7">
    <div class="flex items-center gap-3">
      <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-50 text-brand-600">
        <Icon name="check" class="h-5 w-5" />
      </span>
      <h3 class="text-lg font-bold text-ink-900">{copy.title}</h3>
    </div>
    <p class="mt-3 text-sm text-ink-600 leading-relaxed">{copy.body}</p>

    <div class="mt-5 grid gap-2.5 sm:grid-cols-2">
      <a
        href={hasEn ? enPath : undefined}
        target={hasEn ? '_blank' : undefined}
        rel={hasEn ? 'noopener' : undefined}
        download={hasEn ? '' : undefined}
        aria-disabled={!hasEn}
        class:list={[
          'inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold transition',
          hasEn
            ? 'bg-brand-600 text-white hover:bg-brand-700'
            : 'bg-ink-100 text-ink-400 cursor-not-allowed pointer-events-none',
        ]}
      >
        <Icon name="arrow" class="h-4 w-4 rotate-90" />
        {copy.enLabel}{!hasEn && ` · ${copy.soon}`}
      </a>
      <a
        href={hasEs ? esPath : undefined}
        target={hasEs ? '_blank' : undefined}
        rel={hasEs ? 'noopener' : undefined}
        download={hasEs ? '' : undefined}
        aria-disabled={!hasEs}
        class:list={[
          'inline-flex items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold transition',
          hasEs
            ? 'bg-white ring-1 ring-brand-300 text-brand-700 hover:bg-brand-50'
            : 'bg-ink-100 text-ink-400 cursor-not-allowed pointer-events-none',
        ]}
      >
        <Icon name="arrow" class="h-4 w-4 rotate-90" />
        {copy.esLabel}{!hasEs && ` · ${copy.soon}`}
      </a>
    </div>
  </div>
) : (
  <!-- Compact band: used in footer -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-brand-50 text-brand-600">
        <Icon name="check" class="h-4 w-4" />
      </span>
      <span class="text-sm font-semibold text-ink-800">{copy.title}</span>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={hasEn ? enPath : undefined}
        target={hasEn ? '_blank' : undefined}
        rel={hasEn ? 'noopener' : undefined}
        download={hasEn ? '' : undefined}
        aria-disabled={!hasEn}
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition',
          hasEn
            ? 'bg-white ring-1 ring-brand-200 text-brand-700 hover:bg-brand-50'
            : 'bg-ink-100 text-ink-400 cursor-not-allowed pointer-events-none',
        ]}
      >
        <Icon name="arrow" class="h-3.5 w-3.5 rotate-90" />
        {copy.enLabel}{!hasEn && ` · ${copy.soon}`}
      </a>
      <a
        href={hasEs ? esPath : undefined}
        target={hasEs ? '_blank' : undefined}
        rel={hasEs ? 'noopener' : undefined}
        download={hasEs ? '' : undefined}
        aria-disabled={!hasEs}
        class:list={[
          'inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition',
          hasEs
            ? 'bg-white ring-1 ring-brand-200 text-brand-700 hover:bg-brand-50'
            : 'bg-ink-100 text-ink-400 cursor-not-allowed pointer-events-none',
        ]}
      >
        <Icon name="arrow" class="h-3.5 w-3.5 rotate-90" />
        {copy.esLabel}{!hasEs && ` · ${copy.soon}`}
      </a>
    </div>
  </div>
)}
