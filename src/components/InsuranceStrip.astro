---
import Icon from './Icon.astro';
import { localizedPath, type Lang } from '../i18n/ui';
import { insurancePreview } from '../data/insurances';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = (p: string) => localizedPath(lang, p);

const copy = lang === 'es'
  ? {
      eyebrow: 'Seguros',
      title: 'Aceptamos la mayoría de los seguros médicos',
      body: '¿No ves el tuyo? Llámanos y lo verificamos antes de tu primera cita.',
      cta: 'Ver todos los seguros aceptados',
    }
  : {
      eyebrow: 'Insurance',
      title: 'Most major insurances accepted',
      body: "Don't see yours? Call us and we'll verify your coverage before your first visit.",
      cta: 'See all accepted plans',
    };
---
<section class="bg-white pt-0 pb-16 md:pb-20 -mt-8 md:-mt-12">
  <div class="container-x">
    <div class="rounded-[2rem] bg-white ring-1 ring-ink-100 px-6 py-8 md:px-10 md:py-10">
      <div class="grid lg:grid-cols-12 gap-6 lg:gap-10 items-center">
        <div class="lg:col-span-5">
          <span class="text-xs font-bold uppercase tracking-[0.22em] text-brand-700">{copy.eyebrow}</span>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold tracking-tight text-ink-900 leading-tight">
            {copy.title}
          </h2>
          <p class="mt-3 text-sm md:text-base text-ink-600 leading-relaxed">
            {copy.body}
          </p>
          <a
            href={L('/insurance')}
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700 transition shadow-sm"
          >
            {copy.cta}
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>

        <div class="lg:col-span-7">
          <ul class="flex flex-wrap gap-2">
            {insurancePreview.map((name) => (
              <li class="inline-flex items-center gap-1.5 rounded-full bg-white ring-1 ring-brand-100 px-3.5 py-1.5 text-xs md:text-sm font-semibold text-brand-800">
                <Icon name="check" class="h-3.5 w-3.5 text-brand-600" />
                {name}
              </li>
            ))}
            <li class="inline-flex items-center rounded-full bg-brand-600/5 ring-1 ring-brand-200 px-3.5 py-1.5 text-xs md:text-sm font-semibold text-brand-700 italic">
              + {lang === 'es' ? 'muchos más' : 'many more'}
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
