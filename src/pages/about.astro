---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';

const pillars = [
  {
    icon: 'check',
    title: 'Hand-picked therapists',
    body: 'Every clinician on our team is exclusively selected — not just for experience and skill, but for dedication, compassion, and motivation to ensure optimal patient outcomes and satisfaction.',
  },
  {
    icon: 'check',
    title: 'A consistent treatment philosophy',
    body: "Each therapist is trained in our philosophy of improving optimal function, mobility, strength, and stability through specific treatment techniques and intervention strategies.",
  },
  {
    icon: 'check',
    title: 'Individualized intervention plans',
    body: 'After your initial evaluation, your functional deficits are documented alongside your personal goals to build an intervention plan designed for you — not a template.',
  },
  {
    icon: 'check',
    title: 'Therapist-guided exercise',
    body: 'Your activities are guided by a licensed therapist who ensures proper form, prevents injury, and progresses your plan based on how your body responds.',
  },
  {
    icon: 'check',
    title: 'Wellness beyond discharge',
    body: 'Once you complete therapy, you can join our wellness programs — staying strong, mobile, and active long after the treatment plan ends.',
  },
  {
    icon: 'check',
    title: 'Evidence-based throughout',
    body: 'All modalities of treatment have been scientifically tested and researched to improve patient outcomes.',
  },
];
---
<BaseLayout
  title="About LIV Active Therapy — Miami's PT & OT Specialists"
  description="LIV Active Therapy — hand-picked physical and occupational therapists delivering personalized rehabilitation in Kendall and Doral, Miami."
  lang="en"
>
  <PageHero eyebrow="About us" subtitle="Hand-picked therapists. Individualized plans. A philosophy that doesn't end at discharge.">
    Built around <span class="text-brand-600 italic">your</span> recovery.
  </PageHero>

  <!-- Philosophy / our approach -->
  <section class="container-x py-16 md:py-20">
    <!-- Block 1: Featured intro (image left, text right) -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="hidden lg:block lg:col-span-5">
        <img
          src="/about/main-1.jpg"
          alt="LIV Active Therapy team"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full object-cover rounded-[2rem] ring-1 ring-brand-300/50 shadow-xl shadow-brand-900/10"
        />
      </div>
      <div class="lg:col-span-7">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700">01 — Our team</span>
        <h3 class="mt-3 text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">
          Hand-picked therapists, trained in one philosophy.
        </h3>
        <p class="mt-5 text-base md:text-lg text-ink-700 leading-relaxed">
          We hire occupational and physical therapists who have been exclusively selected — not only for their experience, knowledge, and skills, but for their dedication, compassion, and motivation to ensure optimal patient outcomes.
        </p>
        <p class="mt-4 text-base md:text-lg text-ink-700 leading-relaxed">
          Each therapist is trained in Liv Active Therapy Center's philosophy of improving optimal function, mobility, strength, and stability — using a systematic approach with specific treatment techniques and intervention strategies.
        </p>
      </div>
    </div>

    <!-- Block 2: 4-step journey -->
    <div class="mt-24">
      <div class="text-center max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700">02 — Your journey</span>
        <h3 class="mt-3 text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">
          From your first visit to long-term wellness
        </h3>
      </div>

      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { n: '01', title: 'Initial evaluation', body: 'We document your functional deficits alongside your personal goals to understand exactly what you need.' },
          { n: '02', title: 'Personalized plan', body: 'An individualized intervention plan — not a template — built from patient education, manual therapy, and targeted exercise.' },
          { n: '03', title: 'Active treatment', body: 'Your therapist guides your exercises and adjusts your program to ensure proper form, prevent injury, and progress as symptoms diminish.' },
          { n: '04', title: 'Wellness beyond', body: 'Once discharged, join our wellness programs to maintain strength, mobility, and confidence — supervised by our staff.' },
        ].map((step) => (
          <li class="group relative rounded-2xl bg-white ring-1 ring-ink-100 p-6 hover:ring-brand-300 hover:-translate-y-1 transition-all duration-300">
            <div class="text-5xl font-display font-extrabold text-brand-200 group-hover:text-brand-300 transition-colors leading-none">
              {step.n}
            </div>
            <h4 class="mt-3 text-lg font-bold text-ink-900">{step.title}</h4>
            <p class="mt-2 text-sm text-ink-600 leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- Block 3: Big pull quote -->
    <div class="mt-24 relative">
      <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-brand-700 via-brand-600 to-brand-800 px-8 py-14 md:px-16 md:py-20 shadow-2xl shadow-brand-900/20">
        <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-accent-400/30 blur-3xl"></div>

        <svg aria-hidden="true" class="relative h-12 w-12 text-accent-300/80" viewBox="0 0 24 24" fill="currentColor">
          <path d="M9 7H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3a2 2 0 0 1-2 2H4v2h1a4 4 0 0 0 4-4V7zM21 7h-4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h2v3a2 2 0 0 1-2 2h-1v2h1a4 4 0 0 0 4-4V7z" />
        </svg>
        <p class="relative mt-4 text-2xl md:text-4xl font-display font-semibold text-white italic leading-snug max-w-4xl">
          All modalities of treatment have been scientifically tested and researched to improve patient outcomes.
        </p>
        <div class="relative mt-6 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-accent-200">
          <span class="h-1 w-8 bg-accent-300 rounded-full"></span>
          The LIV Active standard
        </div>
      </div>
    </div>

    <!-- Block 4: Closing (text left, image right) -->
    <div class="mt-24 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 lg:order-1 order-2">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700">03 — Rooted in research</span>
        <h3 class="mt-3 text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">
          Modalities backed by science. Decisions backed by evidence.
        </h3>
        <p class="mt-5 text-base md:text-lg text-ink-700 leading-relaxed">
          During every appointment, the physical therapist uses several modalities to facilitate healing — increasing circulation and oxygenation, and decreasing swelling. Our therapists' determinations of individualized treatments are rooted in current research and clinical case studies.
        </p>
        <ul class="mt-6 grid sm:grid-cols-2 gap-3">
          {[
            'Manual therapy',
            'Therapeutic exercise',
            'Modalities & stretching',
            'Patient education',
          ].map((item) => (
            <li class="flex items-center gap-2.5 text-sm text-ink-700">
              <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-brand-100 text-brand-700 shrink-0">
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="hidden lg:block lg:col-span-5 lg:order-2 order-1">
        <img
          src="/about/main-2.jpg"
          alt="LIV Active Therapy treatment"
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full object-cover rounded-[2rem] ring-1 ring-brand-300/50 shadow-xl shadow-brand-900/10"
        />
      </div>
    </div>
  </section>

  <!-- How we care for you -->
  <section class="container-x py-20 border-t border-ink-100">
    <h2 class="text-3xl md:text-4xl font-bold text-ink-900">How we care for you</h2>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {pillars.map((p) => (
        <li class="rounded-[var(--radius-card)] bg-white p-7 ring-1 ring-ink-100">
          <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center">
            <Icon name={p.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-4 text-lg font-semibold text-ink-900">{p.title}</h3>
          <p class="mt-2 text-sm text-ink-600 leading-relaxed">{p.body}</p>
        </li>
      ))}
    </ul>
  </section>

</BaseLayout>
