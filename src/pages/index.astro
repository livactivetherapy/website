---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import AccidentInjuryStrip from '../components/AccidentInjuryStrip.astro';
import Promise from '../components/Promise.astro';
import TeamPreview from '../components/TeamPreview.astro';
import LocationsPreview from '../components/LocationsPreview.astro';
import InsuranceStrip from '../components/InsuranceStrip.astro';
import AboutPreview from '../components/AboutPreview.astro';
---
