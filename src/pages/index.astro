>
  <Hero lang="en" />
  <ServicesGrid lang="en" />
  <Promise lang="en" />
  <TeamPreview lang="en" compact />
  <LocationsPreview lang="en" />
  <InsuranceStrip lang="en" />
  <AccidentInjuryStrip lang="en" />
  <AboutPreview lang="en" />
</BaseLayout>
