---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath } from '../../i18n/ui';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.lang === 'en');
  return services.map((s) => ({ params: { slug: s.data.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations('en');
const L = (p: string) => localizedPath('en', p);
---
<BaseLayout title={`${entry.data.title} — LIV Active Therapy`} description={entry.data.summary} lang="en">
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="container-x pt-14 pb-16 md:pt-20 md:pb-20">
      <a href={L('/services')} class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 hover:text-brand-800">
        <Icon name="arrow" class="h-4 w-4 rotate-180" />
        All services
      </a>
      <div class="mt-6 flex items-start gap-5">
        <div class="h-14 w-14 shrink-0 rounded-2xl bg-white ring-1 ring-brand-200 text-brand-700 flex items-center justify-center shadow-sm">
          <Icon name={entry.data.icon} class="h-7 w-7" />
        </div>
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-ink-900">{entry.data.title}</h1>
          <p class="mt-4 max-w-2xl text-lg text-ink-600">{entry.data.summary}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-16 grid lg:grid-cols-3 gap-12">
    <article class="lg:col-span-2 prose prose-lg max-w-none prose-headings:font-display prose-headings:tracking-tight">
      <Content />

      {entry.data.whatToExpect.length > 0 && (
        <>
          <h2>What to expect</h2>
          <ul>
            {entry.data.whatToExpect.map((item) => <li>{item}</li>)}
          </ul>
        </>
      )}
    </article>

    <aside class="space-y-6">
      {entry.data.conditions.length > 0 && (
        <div class="rounded-[var(--radius-card)] bg-ink-50 p-6 ring-1 ring-ink-100">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-ink-500">Conditions we treat</h3>
          <ul class="mt-4 space-y-2.5">
            {entry.data.conditions.map((c) => (
              <li class="flex gap-2 text-sm text-ink-800">
                <Icon name="check" class="h-4 w-4 mt-0.5 text-brand-600 shrink-0" />
                {c}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-[var(--radius-card)] bg-brand-700 p-6 text-white">
        <h3 class="text-lg font-semibold">Ready to get started?</h3>
        <p class="mt-2 text-sm text-brand-100">Most patients are seen within 48 hours.</p>
        <a
          href={site.locations[0].phoneHref}
          class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50"
        >
          <Icon name="phone" class="h-4 w-4" />
          {t('cta.call')}
        </a>
      </div>
    </aside>
  </section>

</BaseLayout>
