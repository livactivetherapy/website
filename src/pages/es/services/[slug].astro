---
import { getCollection } from 'astro:content';
import ServicePage from '../../../components/ServicePage.astro';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => data.lang === 'es');
  return services.map((s) => ({ params: { slug: s.data.slug }, props: { entry: s } }));
}

const { entry } = Astro.props;
---
<ServicePage entry={entry} lang="es" />
